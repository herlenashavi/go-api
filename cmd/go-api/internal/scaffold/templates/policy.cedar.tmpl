// Authorization policy for {{.ServiceName}}. Generated by `go-api new` —
// a starting point (viewer/editor/admin, the same role shape
// examples/heroes uses), not a finished policy. Edit this to match your
// actual access rules; see docs/authorization.md.
{{range .Resources}}
// viewer (and anyone above it) can list and read {{.Plural}}.
permit (
  principal in Role::"viewer",
  action in [Action::"{{.Lower}}:list", Action::"{{.Lower}}:read"],
  resource
);

// editor (and admin) can create and update {{.Plural}}.
permit (
  principal in Role::"editor",
  action in [Action::"{{.Lower}}:create", Action::"{{.Lower}}:update"],
  resource
);

// only admin can delete a {{.Lower}}.
permit (
  principal in Role::"admin",
  action == Action::"{{.Lower}}:delete",
  resource
);
{{end}}
